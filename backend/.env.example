# Copy this file to ".env" and put your own values. ".env" never goes to GitHub (it is in .gitignore).
# Never email or upload your real .env file.

# --- required ---
DB_PASS=your_mysql_password
ADMIN_CODE=choose_a_long_secret_admin_invite_code      # if empty, admin sign-up is switched off

# --- optional (defaults shown) ---
# DB_USER=root                  # better: create the least-privilege user from database/07_security.sql and use it here
# DB_HOST=localhost
# DB_NAME=tripnest
# SESSION_HOURS=12              # how long a login stays valid
# PORT=3000
# HOST=127.0.0.1                # only this computer can open the site. Use 0.0.0.0 to share on your Wi-Fi
# CORS_ORIGIN=                  # only if the frontend runs on another origin, e.g. http://127.0.0.1:5500
